[TEMPLATE]
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/bubble.db
ENCRYPTION_KEY=your-fernet-key-here

# --- Authentication ---------------------------------------------------------
# Google OAuth client ID (public, not a secret). See docs/google-auth-setup.md.
# Used to verify ID tokens on /api/v1/auth/google and by the web login page.
GOOGLE_CLIENT_ID=
# Comma-separated CORS allowlist. Leave empty in development (permissive for
# localhost). In production this MUST list your real origins, e.g.:
#   CORS_ORIGINS=https://your-domain.com,chrome-extension://YOUR_EXTENSION_ID
CORS_ORIGINS=
# Bubble AI application session lifetime in seconds (default 7 days).
SESSION_TTL_SECONDS=604800
# Production: comma-separated admin emails allowed on /providers/* endpoints.
BUBBLE_ADMIN_EMAILS=

# --- AI provider keys (server-side only; never expose to clients) ------------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- GitHub OAuth (optional) -------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Application configuration -----------------------------------------------
MEMORY_COMPRESSION_INTERVAL=5
MAX_CONTEXT_MESSAGES=20
RATE_LIMIT=100
